<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotelMelissa.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Forest">#173B3A</Color>
            <Color x:Key="DeepForest">#102D2C</Color>
            <Color x:Key="Black">#000000</Color>
            <Color x:Key="Terracotta">#B56D52</Color>
            <Color x:Key="Sand">#F5F1E8</Color>
            <Color x:Key="Cream">#F7F4ED</Color>
            <Color x:Key="Ink">#263635</Color>
            <Color x:Key="Muted">#71817D</Color>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
