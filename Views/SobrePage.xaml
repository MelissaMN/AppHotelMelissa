<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotelMelissa.Views.SobrePage"
             Title="Sobre" BackgroundColor="#F7F4ED">
    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="24,30">
            <Border BackgroundColor="#173B3A" StrokeThickness="0" Padding="24" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✦" FontSize="32" TextColor="#D8B779" />
                    <Label Text="SERENA HOTEL" FontSize="12" TextColor="#D8B779" CharacterSpacing="3" FontAttributes="Bold" />
                    <Label Text="Sobre o projeto" FontSize="29" TextColor="White" FontAttributes="Bold" />
                    <Label Text="Uma experiência de hospedagem pensada para transmitir tranquilidade, acolhimento e elegância." FontSize="13" TextColor="#E0E8E3" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="O APLICATIVO" FontSize="10" TextColor="#A17E43" FontAttributes="Bold" CharacterSpacing="2" />
                <Label Text="Este projeto foi desenvolvido como atividade acadêmica de Programação Mobile I, com base na Agenda 13 — Imagens e Componentes Diversos de Interface Gráfica." FontSize="14" TextColor="#465653" LineHeight="1.35" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E8E2D7" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="INFORMAÇÕES DO DESENVOLVIMENTO" FontSize="10" TextColor="#A17E43" FontAttributes="Bold" CharacterSpacing="1.2" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Desenvolvedora" FontSize="11" TextColor="#8A9691" />
                        <Label Text="Melissa Marconde Nogueira" FontSize="16" FontAttributes="Bold" TextColor="#173B3A" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#EEEAE2" />
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Ano" FontSize="11" TextColor="#8A9691" />
                            <Label Text="2026" FontSize="16" FontAttributes="Bold" TextColor="#173B3A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Tecnologia" FontSize="11" TextColor="#8A9691" />
                            <Label Text=".NET MAUI · C# · XAML" FontSize="13" FontAttributes="Bold" TextColor="#173B3A" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="7">
                <Label Text="RECURSOS APLICADOS" FontSize="10" TextColor="#A17E43" FontAttributes="Bold" CharacterSpacing="1.5" />
                <Label Text="• BindingContext e data binding\n• Stepper para quantidade de hóspedes\n• DatePicker para data de check-in\n• Picker para tipo de acomodação\n• Navegação entre páginas" FontSize="13" TextColor="#465653" LineHeight="1.4" />
            </VerticalStackLayout>
            <Button Text="← Voltar para o início" BackgroundColor="#173B3A" TextColor="White" Clicked="OnVoltarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
